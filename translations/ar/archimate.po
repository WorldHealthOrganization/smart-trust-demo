#: archimate/0.1.0/view/id-76c0e5d33b895f68af49f8590466474b.svg:0
msgid "national datasets"
msgstr "مجموعات البيانات الوطنية"

#: archimate/0.1.0/model.json:0
msgid "National Health Workforce Accounts (NHWA) dataset. Not a second registry: an analytical linking and indexing dataset that builds on CDE-HWR. The HWR identifier is the key that links records about the same worker held in other data systems, which the NHWA handbook lists as potential data sources: the health workforce registry or database, facility administrative records and HMIS, professional council registers, labour force surveys and population census. From these, the 29 NHWA indicators in 4 modules are computed (1 stock and flow; 2 education; 3 finance and expenditures; 4 working conditions, governance and leadership) and reported nationally and to the WHO NHWA platform. Source: WHO, National health workforce accounts: a handbook, 2nd ed., 2023 (ISBN 9789240081291): the NHWA is \"a system by which countries progressively improve the availability, quality, and use of data on health workforce through monitoring of a set of indicators\", using diverse existing data sources (core principles: multi-sectoral governance, progressive implementation, no primary data collection)."
msgstr "مجموعة بيانات الحسابات الوطنية للقوى العاملة الصحية (NHWA). ليست سجلًا ثانيًا: بل مجموعة بيانات تحليلية للربط والفهرسة تبني على CDE-HWR. ومعرّف HWR هو المفتاح الذي يربط السجلات الخاصة بالعامل نفسه والمحفوظة في أنظمة بيانات أخرى، والتي يدرجها دليل NHWA بوصفها مصادر بيانات محتملة: سجل القوى العاملة الصحية أو قاعدة بياناتها، والسجلات الإدارية للمرافق وHMIS، وسجلات المجالس المهنية، ومسوح القوى العاملة، والتعداد السكاني. ومنها تُحسب مؤشرات NHWA البالغ عددها 29 في 4 وحدات (1 الرصيد والتدفق؛ 2 التعليم؛ 3 التمويل والإنفاق؛ 4 ظروف العمل والحوكمة والقيادة) ويُبلَّغ عنها على المستوى الوطني وإلى منصة NHWA التابعة لمنظمة الصحة العالمية. المصدر: منظمة الصحة العالمية، الحسابات الوطنية للقوى العاملة الصحية: دليل، الطبعة الثانية، 2023 (ISBN 9789240081291): الحسابات الوطنية للقوى العاملة الصحية هي «نظام تُحسّن به البلدان تدريجيًا توفّر البيانات المتعلقة بالقوى العاملة الصحية وجودتها واستخدامها من خلال رصد مجموعة من المؤشرات»، باستخدام مصادر بيانات قائمة متنوعة (المبادئ الأساسية: الحوكمة متعددة القطاعات، والتنفيذ التدريجي، وعدم جمع بيانات أولية)."

