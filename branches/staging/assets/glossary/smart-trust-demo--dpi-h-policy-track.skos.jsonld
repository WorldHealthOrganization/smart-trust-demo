      "skos:altLabel": [
        "DPI for health",
        "DPI-H"
      ],
      "skos:definition": [
        {
          "@value": "Health Digital Public Infrastructure (DPI-H) refers to digital resources that are built as a shared means for fulfilling multiple health agency functions."
        }
      ],
      "skos:notation": "DPI-H",
      "skos:scopeNote": "Definition from the DPI-H Reference Architecture glossary (smart-ra, health-digital-public-infrastructure), verbatim; it replaces the policy-maker track handout's wording (owner, 2026-11-16). Handout section: Infrastructure and architecture.",
