Instance: TrustDemoDT03
InstanceOf: PlanDefinition
Title: "TD.DT.03 Does the national schedule count this dose?"
Description: "For one Immunization in the child's record, decide whether the schedule evaluation counts it as given."
Usage: #definition
* url = "http://smart.who.int/trust-demo/PlanDefinition/TrustDemoDT03"
* name = "TrustDemoDT03"
* title = "TD.DT.03 Does the national schedule count this dose?"
* status = #draft
* experimental = true
* type = http://terminology.hl7.org/CodeSystem/plan-definition-type#eca-rule
* description = "For one Immunization in the child's record, decide whether the schedule evaluation counts it as given. Requirements: STD-SCH-001, STD-SEM-001. Hit policy FIRST: the rules are tried in order and the first that matches applies."
* relatedArtifact[+].type = #documentation
* relatedArtifact[=].display = "Decision table TD.DT.03 (OMG DMN 1.3): dose-counts.dmn"
